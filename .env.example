APP_ENV=local
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Manila
# Use true to preview the landing page with the README clinic content locally.
LANDING_PREVIEW=false
# Generate with php -r "echo bin2hex(random_bytes(32));"
APP_KEY=

# Supabase Dashboard > Connect > Transaction pooler. Copy the actual host and user.
DB_HOST=
DB_PORT=6543
DB_DATABASE=postgres
DB_USERNAME=
DB_PASSWORD=
DB_SSLMODE=require

# Required for new-account OTP email. MAIL_ENABLED controls appointment notifications only.
MAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_AUTH=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Rebadulla Animal Care"
